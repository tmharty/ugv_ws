<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ugv_nav</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="ws@todo.todo">ws</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>nav2_bringup</depend>

  <!-- launched by ugv_nav launch files / referenced by nav2 param plugins -->
  <exec_depend>emcl2</exec_depend>
  <!-- local planner: nav2 MPPI (+ rotation shim) replaces teb_local_planner,
       which has no Jazzy release. DWB (dwa option) ships with nav2. -->
  <exec_depend>nav2_mppi_controller</exec_depend>
  <exec_depend>nav2_rotation_shim_controller</exec_depend>
  <exec_depend>nav2_dwb_controller</exec_depend>
  <exec_depend>robot_pose_publisher</exec_depend>
  <exec_depend>explore_lite</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
