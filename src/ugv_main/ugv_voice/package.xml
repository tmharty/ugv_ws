<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ugv_voice</name>
  <version>0.1.0</version>
  <description>Voice control: ear (ASR), brain (intent + validation), mouth (TTS).
    All motion goes through the Behavior action / behavior_ctrl safety layer.</description>
  <maintainer email="travisharty@gmail.com">Travis Harty</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>ugv_interface</depend>

  <!-- voice.launch.py starts the behavior_ctrl motion seam from ugv_tools -->
  <exec_depend>ugv_tools</exec_depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-requests</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
